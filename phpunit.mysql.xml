<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="MySQL concurrency">
            <directory>tests/MySql</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="mysql-concurrency" force="true"/>
        <env name="DB_DATABASE" value="foco_concurrency" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
    </php>
</phpunit>
